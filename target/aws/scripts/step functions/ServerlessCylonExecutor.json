{
  "Comment": "A description of my state machine",
  "StartAt": "Cylon init",
  "States": {
    "Cylon init": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "OutputPath": "$.Payload",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:us-east-1:448324707516:function:cylon_init:$LATEST",
        "Payload.$": "$"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Next": "Map"
    },
    "Map": {
      "Type": "Map",
      "ItemsPath": "$.body",
      "ResultPath": "$.MapOutput",
      "MaxConcurrency": 1000,
      "Iterator": {
        "StartAt": "ExtractAndInvokeLambda",
        "States": {
          "ExtractAndInvokeLambda": {
            "Type": "Pass",
            "InputPath": "$",
            "ResultPath": "$",
            "Next": "Lambda Invoke Cylon"
          },
          "Lambda Invoke Cylon": {
            "Type": "Task",
            "Resource": "arn:aws:states:::lambda:invoke",
            "Parameters": {
              "FunctionName": "arn:aws:lambda:us-east-1:448324707516:function:cylon_executor:$LATEST",
              "Payload.$": "$"
            },
            "OutputPath": "$.Payload",
            "Retry": [
              {
                "ErrorEquals": [
                  "Lambda.ServiceException",
                  "Lambda.AWSLambdaException",
                  "Lambda.SdkClientException",
                  "Lambda.TooManyRequestsException"
                ],
                "IntervalSeconds": 1,
                "MaxAttempts": 3,
                "BackoffRate": 2
              }
            ],
            "End": true
          }
        },
        "ProcessorConfig": {
          "Mode": "DISTRIBUTED",
          "ExecutionType": "STANDARD"
        }
      },
      "End": true,
      "Label": "Map"
    }
  }
}